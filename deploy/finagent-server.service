[Unit]
Description=FinAgent - Bo giam sat thi truong (may chu)
Documentation=file://__FINAGENT_DIR__/README.md
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=__FINAGENT_USER__
Group=__FINAGENT_USER__
WorkingDirectory=__FINAGENT_DIR__
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-__FINAGENT_DIR__/.env

# Bo giam sat: thu thập dinh ky tu may con, quet thi truong, ra quyet dinh.
ExecStart=__FINAGENT_DIR__/.venv/bin/finagent run

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finagent-server

# Bao mat co ban
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__FINAGENT_DIR__/data

[Install]
WantedBy=multi-user.target
