# =============================================================================
#  FinAgent — mẫu cấu hình
#  Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# =============================================================================

# --- Hạ tầng phân tán (bắt buộc) ---------------------------------------------
# Địa chỉ Redis dùng chung giữa máy chủ và các máy con.
# Trên máy chủ để 127.0.0.1; máy con trỏ về IP LAN của máy chủ.
REDIS_URL=redis://127.0.0.1:6379/0

# Tổng số việc thu thập chạy song song trên TOÀN BỘ máy con.
# Thêm máy con không làm tăng quá ngưỡng này, tránh quá tải nguồn dữ liệu.
FINAGENT_MAX_CONCURRENCY=10

# Số tiến trình con mỗi máy con tự chạy.
FINAGENT_WORKER_CONCURRENCY=4

# --- Mô hình ngôn ngữ (khuyến nghị) ------------------------------------------
# Điền khoá của nhà cung cấp bạn dùng, rồi đặt TRADINGAGENTS_LLM_PROVIDER cho khớp.
# FinAgent tự tìm đúng biến môi trường theo nhà cung cấp đã chọn.
#
#   google    → GOOGLE_API_KEY      (https://aistudio.google.com/apikey)
#   deepseek  → DEEPSEEK_API_KEY    (https://platform.deepseek.com)
#   openai    → OPENAI_API_KEY
#   anthropic → ANTHROPIC_API_KEY
#   ollama    → không cần khoá (chạy cục bộ)
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

TRADINGAGENTS_LLM_PROVIDER=google
# Model suy luận sâu (tranh luận, quyết định cuối).
# Lưu ý: gói miễn phí của Google chỉ cho dùng dòng Flash; các model Pro hết quota.
TRADINGAGENTS_DEEP_THINK_LLM=gemini-3.8-flash
# Model cho việc nhẹ, nhanh và rẻ hơn.
TRADINGAGENTS_QUICK_THINK_LLM=gemini-2.5-flash
TRADINGAGENTS_OUTPUT_LANGUAGE=Vietnamese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
# Ghi đè endpoint LLM. Để trống thì dùng mặc định của nhà cung cấp.
# Hữu ích khi trỏ vào endpoint tự lưu trữ (vLLM, LM Studio, Ollama).
#TRADINGAGENTS_LLM_BACKEND_URL=http://127.0.0.1:8000/v1

# --- Telegram (khuyến nghị) --------------------------------------------------
# Tạo bot qua @BotFather để lấy token; lấy chat_id qua @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Đổi được để dùng Bot API tự lưu trữ (mặc định là api.telegram.org).
#TELEGRAM_API_BASE=https://api.telegram.org
# Thời gian chờ người dùng bấm duyệt trước khi đề xuất hết hạn (giây).
FINAGENT_APPROVAL_TIMEOUT=900

# --- Giao dịch ---------------------------------------------------------------
# paper = mô phỏng (khuyến nghị). live = đặt lệnh thật, chỉ dùng khi đã cắm broker.
FINAGENT_TRADING_MODE=paper
FINAGENT_PAPER_CASH=1000000000
# Chỉ hành động khi độ tin cậy đạt mức này.
FINAGENT_MIN_CONFIDENCE=0.55
# Tỷ lệ vốn tối đa cho một lệnh.
FINAGENT_MAX_POSITION_PCT=0.10
# Lệnh vượt ngưỡng này (VND) bắt buộc người dùng duyệt.
FINAGENT_APPROVAL_THRESHOLD=5000000

# --- Danh mục theo dõi -------------------------------------------------------
FINAGENT_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
FINAGENT_VN_SYMBOLS=VNM,FPT,HPG,VCB,TCB
FINAGENT_GOLD_SYMBOLS=SJL1L10,DOJINHTV,PQHNVM,BT9999NTT,XAUUSD

# --- Nhịp giám sát (giây) ----------------------------------------------------
FINAGENT_NEWS_INTERVAL=900
FINAGENT_MONITOR_INTERVAL=300
FINAGENT_NEWS_MAX_ITEMS=40

# --- Khác --------------------------------------------------------------------
FINAGENT_DB=data/finagent.db
FINAGENT_LOG_LEVEL=INFO

# --- Ví mô phỏng -------------------------------------------------------------
# Crypto niêm yết bằng USDT nên có ví USDT riêng, tách khỏi ví tiền đồng.
FINAGENT_PAPER_USDT=5000
# Tỷ giá quy đổi khi hiển thị tổng giá trị danh mục bằng VND.
FINAGENT_USDT_VND=26300
