# =============================================================================
#  FinAgent — mẫu cấu hình
#  Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# =============================================================================

# --- Hạ tầng phân tán (bắt buộc) ---------------------------------------------
# Địa chỉ Redis dùng chung giữa máy chủ và các máy con.
# Trên máy chủ để 127.0.0.1; máy con trỏ về IP LAN của máy chủ.
REDIS_URL=redis://127.0.0.1:6379/0

# Tổng số việc thu thập chạy song song trên TOÀN BỘ máy con.
# Thêm máy con không làm tăng quá ngưỡng này, tránh quá tải nguồn dữ liệu.
FINAGENT_MAX_CONCURRENCY=10

# Số tiến trình con mỗi máy con tự chạy.
FINAGENT_WORKER_CONCURRENCY=4

# --- Mô hình ngôn ngữ (khuyến nghị) ------------------------------------------
# Điền khoá của nhà cung cấp bạn dùng, rồi đặt TRADINGAGENTS_LLM_PROVIDER cho khớp.
# FinAgent tự tìm đúng biến môi trường theo nhà cung cấp đã chọn.
#
#   google    → GOOGLE_API_KEY      (https://aistudio.google.com/apikey)
#   deepseek  → DEEPSEEK_API_KEY    (https://platform.deepseek.com)
#   openai    → OPENAI_API_KEY
#   anthropic → ANTHROPIC_API_KEY
#   ollama    → không cần khoá (chạy cục bộ)
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Endpoint OpenAI-compatible. Dùng opencode zen (https://opencode.ai/zen/v1).
# Cũng dùng được cho vLLM, LM Studio, llama.cpp hoặc gateway nội bộ.
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=https://opencode.ai/zen/v1
OPENAI_COMPATIBLE_API_KEY=

# Ghi chú: gói miễn phí của Google chỉ cho 20 request/ngày cho MỖI model, mà một
# lượt phân tích đa tác nhân tốn khoảng 20 lời gọi — vừa đủ một lượt rồi hết.
# Không đủ dùng thực tế.
#
# deepseek-v4.1-flash là model suy luận: phần lớn token đầu dùng cho reasoning
# nên cần đặt max_tokens rộng, đừng giới hạn chặt.
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4.1-flash
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4.1-flash
# Số lần thử lại khi bị chặn tạm thời.
TRADINGAGENTS_LLM_MAX_RETRIES=8
TRADINGAGENTS_OUTPUT_LANGUAGE=Vietnamese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
# Ghi đè endpoint LLM. Để trống thì dùng mặc định của nhà cung cấp.
# Hữu ích khi trỏ vào endpoint tự lưu trữ (vLLM, LM Studio, Ollama).
#TRADINGAGENTS_LLM_BACKEND_URL=http://127.0.0.1:8000/v1

# --- Telegram (khuyến nghị) --------------------------------------------------
# Tạo bot qua @BotFather để lấy token; lấy chat_id qua @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Đổi được để dùng Bot API tự lưu trữ (mặc định là api.telegram.org).
#TELEGRAM_API_BASE=https://api.telegram.org
# Thời gian chờ người dùng bấm duyệt trước khi đề xuất hết hạn (giây).
FINAGENT_APPROVAL_TIMEOUT=900

# --- Giao dịch ---------------------------------------------------------------
# paper = mô phỏng cục bộ, không ra ngoài (khuyến nghị bắt đầu).
# live  = đặt lệnh thật trên Binance (xem cấu hình BINANCE_* bên dưới).
FINAGENT_TRADING_MODE=paper
FINAGENT_PAPER_CASH=1000000000

# --- Sàn giao dịch thật (Binance) --------------------------------------------
# Chỉ cần điền khi FINAGENT_TRADING_MODE=live.
#
# Lấy khoá TESTNET miễn phí tại https://testnet.binance.vision (đăng nhập GitHub
# → API Key → tạo). Testnet dùng tiền giả nhưng API giống hệt bản thật, nên đây
# là nơi nên thử trước.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true  = Testnet, tiền giả (khuyên dùng)
# false = TIỀN THẬT, phải kèm BINANCE_LIVE_CONFIRM=YES
BINANCE_TESTNET=true
# Cửa chặn cố ý: chỉ khi đặt đúng YES thì mới cho giao dịch tiền thật.
BINANCE_LIVE_CONFIRM=
# Phí sàn spot: 0,1% mặc định; 0,075% nếu trả phí bằng BNB.
BINANCE_FEE_RATE=0.001
# Chỉ hành động khi độ tin cậy đạt mức này.
FINAGENT_MIN_CONFIDENCE=0.55
# Tỷ lệ vốn tối đa cho một lệnh.
FINAGENT_MAX_POSITION_PCT=0.10
# Lệnh vượt ngưỡng này (VND) bắt buộc người dùng duyệt.
FINAGENT_APPROVAL_THRESHOLD=5000000

# --- Danh mục theo dõi -------------------------------------------------------
FINAGENT_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
FINAGENT_VN_SYMBOLS=VNM,FPT,HPG,VCB,TCB
FINAGENT_GOLD_SYMBOLS=SJL1L10,DOJINHTV,PQHNVM,BT9999NTT,XAUUSD

# --- Nhịp giám sát (giây) ----------------------------------------------------
FINAGENT_NEWS_INTERVAL=900
# Nhịp quét thị trường (giây). Phải dài hơn thời gian một lượt quét,
# nếu không bộ lập lịch sẽ thử chạy chồng và ghi cảnh báo liên tục.
FINAGENT_MONITOR_INTERVAL=1800
FINAGENT_NEWS_MAX_ITEMS=40

# --- Khác --------------------------------------------------------------------
FINAGENT_DB=data/finagent.db
FINAGENT_LOG_LEVEL=INFO

# --- Ví mô phỏng -------------------------------------------------------------
# Crypto niêm yết bằng USDT nên có ví USDT riêng, tách khỏi ví tiền đồng.
FINAGENT_PAPER_USDT=5000
# Tỷ giá quy đổi khi hiển thị tổng giá trị danh mục bằng VND.
FINAGENT_USDT_VND=26300

# --- Trí nhớ và tự phản tỉnh -------------------------------------------------
# Bật: hệ thống ghi lại quyết định, lần sau lấy lợi nhuận thực tế rồi tự rút
# kinh nghiệm và bơm vào prompt của Portfolio Manager (học từ sai lầm).
FINAGENT_MEMORY_ENABLED=true
FINAGENT_MEMORY_MAX_ENTRIES=500
FINAGENT_MEMORY_LOG=data/decision_memory.md
# Số ngày nắm giữ trước khi chấm điểm một quyết định.
FINAGENT_HOLDING_DAYS=5

# --- Chạy tiếp khi hỏng ------------------------------------------------------
# LangGraph lưu state sau mỗi bước: hỏng thì chạy lại tiếp, không làm lại từ đầu.
FINAGENT_CHECKPOINT=true
FINAGENT_CHECKPOINT_DIR=data/checkpoints
FINAGENT_RESULTS_DIR=data/results

# --- Độ sâu suy luận ---------------------------------------------------------
# Thêm vòng tranh luận bò/gấu (0 = mặc định). Nhiều hơn = soi kỹ hơn nhưng chậm
# và tốn hạn mức API gấp bội.
FINAGENT_EXTRA_DEBATE_ROUNDS=0
# Mức suy luận của Gemini: low hoặc high (để trống = mặc định của model).
FINAGENT_GOOGLE_THINKING=
TRADINGAGENTS_TEMPERATURE=0.0

# --- Độ giàu ngữ cảnh --------------------------------------------------------
FINAGENT_NEWS_ARTICLE_LIMIT=30
FINAGENT_GLOBAL_NEWS_LIMIT=25
FINAGENT_GLOBAL_NEWS_LOOKBACK=14

# --- Chỉ số chuẩn để chấm điểm alpha -----------------------------------------
# Backtest so lợi nhuận với chỉ số này. Không có chỉ số đúng thị trường thì điểm
# alpha vô nghĩa.
FINAGENT_BENCHMARK_VN=VNINDEX
# Lưu ý: BTC so với chính nó thì alpha luôn 0. Hệ thống tự phát hiện và báo rõ.
FINAGENT_BENCHMARK_CRYPTO=BTCUSDT

# --- Nguồn dữ liệu bổ trợ (không bắt buộc, nhưng nên bật) --------------------
# FRED: chỉ số vĩ mô Mỹ (lãi suất Fed, CPI, lợi suất trái phiếu). Miễn phí tại
# https://fred.stlouisfed.org/docs/api/api_key.html
# Vĩ mô Mỹ tác động trực tiếp tới tỷ giá, vàng và crypto của Việt Nam.
FRED_API_KEY=
# Polymarket: xác suất sự kiện tương lai (Fed giảm lãi suất, suy thoái). Miễn phí.
FINAGENT_POLYMARKET=true

# --- Tốc độ quét ---------------------------------------------------------
# Lọc trước bằng ML rẻ tiền: chỉ gọi LLM cho mã có tín hiệu ra khỏi vùng trung
# tính, hoặc mã đang giữ vị thế. Một lượt LLM tốn ~13 phút/mã nên việc lọc này
# tiết kiệm rất nhiều.
FINAGENT_LLM_PREFILTER=true
# Số mã phân tích LLM chạy song song (các lời gọi chờ mạng là chính).
FINAGENT_SCAN_PARALLELISM=3
# Vùng trung tính của ML; trong khoảng này coi như không có tín hiệu.
FINAGENT_ML_NEUTRAL_BAND=0.05

# --- Giờ giao dịch -------------------------------------------------------
# Chỉ phân tích chứng khoán Việt Nam trong giờ sàn mở cửa. Một lượt phân tích tốn
# khoảng 217.000 token cho mỗi mã, nên phân tích chứng khoán lúc 3 giờ sáng là đốt
# token cho số liệu đã cũ. Crypto không bị ảnh hưởng (chạy 24/7).
FINAGENT_MARKET_HOURS_ONLY=true
FINAGENT_MARKET_OPEN=09:00
FINAGENT_MARKET_CLOSE=15:00

# --- Mốc giờ quét trong ngày ---------------------------------------------
# Quét theo MỐC GIỜ thay vì theo chu kỳ. Một lượt quét 4 mã tốn khoảng 867.000
# token; quét mỗi 30 phút suốt ngày là hơn 1,2 TỶ token mỗi tháng — phần lớn là vô
# nghĩa vì ngoài giờ giao dịch giá và thanh khoản không đổi.
#
#   09:45 — sau khi phiên sáng ổn định, biến động mở cửa đã qua
#   14:00 — trước khi đóng cửa, kịp hành động trong ngày
#
# Để trống thì quay lại quét theo chu kỳ FINAGENT_MONITOR_INTERVAL.
FINAGENT_SCAN_TIMES=09:45,14:00
